# deploy/ubuntu/.env  -- copy this file to `.env` in the same directory and
# fill it in. `.env` is git-ignored; never commit it. Generation commands are
# given for every secret; run them on the server and paste the output.

# --- Domain -----------------------------------------------------------------
# Bare hostname for Caddy (no scheme, no slash). A DNS A/AAAA record for it
# must already point at this server before you run `docker compose up`.
SITE_DOMAIN=example.com
# Same host with scheme, no trailing slash. Builds the URLs in /sitemap.xml.
SITE_URL=https://example.com
# Comma-separated browser origins allowed to call the API. Add the www form
# only if you also enable it in Caddyfile.
CORS_ORIGINS=https://example.com

# --- Database (internal to Docker; docker-compose derives DATABASE_URL) -----
# Generate:  openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Secrets: generate fresh, never reuse dev or Railway values -------------
# Generate:  openssl rand -base64 48
JWT_SECRET_KEY=
# Fernet key that encrypts the SMTP password saved via the admin Settings
# screen. Generate:
#   python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Changing it later just means re-entering the SMTP password in Settings.
ENCRYPTION_KEY=

# --- Anthropic (server-side AI blog assistant; the key never reaches browsers)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- First boot only ----------------------------------------------------------
# Creates the first admin on the first start. After you have logged in and
# changed the password, DELETE these two lines and run `docker compose up -d`
# again. (seed.py skips a user that already exists, so leaving them in is
# harmless but keeps a plaintext password on disk.)
# Generate a temporary password:  openssl rand -base64 18
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# --- Fixed / rarely changed ---------------------------------------------------
DEBUG=false
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
APP_NAME=Ashford & Briggs API
